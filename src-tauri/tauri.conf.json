{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewsical",
  "version": "0.1.21",
  "identifier": "app.tubedesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Viewsical",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#0f0f0f",
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost https: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "capabilities": [
        "main",
        "player-overlay"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../tools/python/": "tools/python/",
      "../tools/licenses/": "tools/licenses/",
      "../tools/manifest.json": "tools/manifest.json",
      "../tools/deno.exe": "tools/deno.exe",
      "../tools/mpv.exe": "tools/mpv.exe",
      "../tools/libmpv-2.dll": "tools/libmpv-2.dll",
      "../tools/d3dcompiler_43.dll": "tools/d3dcompiler_43.dll",
      "../tools/ffmpeg.exe": "tools/ffmpeg.exe",
      "../tools/ffprobe.exe": "tools/ffprobe.exe",
      "../resources/ytdlp-plugins/": "ytdlp-plugins/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Search, play, and keep a local video library",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "Viewsical"
}
